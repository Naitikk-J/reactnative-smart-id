{
  "name": "reactnative-smart-id",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "eas:build:dev:ios": "eas build --platform ios --profile development",
    "eas:build:dev:android": "eas build --platform android --profile development",
    "eas:build:preview:ios": "eas build --platform ios --profile preview",
    "eas:build:preview:android": "eas build --platform android --profile preview",
    "eas:build:prod:ios": "eas build --platform ios --profile production",
    "eas:build:prod:android": "eas build --platform android --profile production",
    "eas:update:preview": "eas update --branch preview --message \"preview OTA update\"",
    "eas:update:production": "eas update --branch production --message \"production OTA update\""
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.15.9",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.11",
    "axios": "^1.15.0",
    "expo": "~54.0.33",
    "expo-camera": "~17.0.10",
    "expo-device": "~8.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-location": "~19.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.16",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "eas-cli": "^18.7.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
